{
  "resources": [
    {
      "name": "XOAP_Folder",
      "type": "File",
      "properties": {
        "Type": "Directory",
        "Ensure": "Present",
        "DestinationPath": "C:\\XOAP"
      }
    },
    {
      "name": "DPS",
      "type": "Service",
      "properties": {
        "Name": "DPS",
        "State": "stopped",
        "StartupType": "Disabled"
      }
    },
    {
      "name": "WdiServiceHost",
      "type": "Service",
      "properties": {
        "Name": "WdiServiceHost",
        "State": "stopped",
        "StartupType": "Disabled"
      }
    },
    {
      "name": "WdiSystemHost",
      "type": "Service",
      "properties": {
        "Name": "WdiSystemHost",
        "State": "stopped",
        "StartupType": "Disabled"
      }
    },
    {
      "name": "EFS",
      "type": "Service",
      "properties": {
        "Name": "EFS",
        "State": "stopped",
        "StartupType": "Disabled"
      }
    },
    {
      "name": "SharedAccess",
      "type": "Service",
      "properties": {
        "Name": "SharedAccess",
        "State": "stopped",
        "StartupType": "Disabled"
      }
    },
    {
      "name": "SstpSvc",
      "type": "Service",
      "properties": {
        "Name": "SstpSvc",
        "State": "stopped",
        "StartupType": "Disabled"
      }
    },
    {
      "name": "SysMain",
      "type": "Service",
      "properties": {
        "Name": "SysMain",
        "State": "stopped",
        "StartupType": "Disabled"
      }
    },
    {
      "name": "WerSvc",
      "type": "Service",
      "properties": {
        "Name": "WerSvc",
        "State": "stopped",
        "StartupType": "Disabled"
      }
    },
    {
      "name": "defragsvc",
      "type": "Service",
      "properties": {
        "Name": "defragsvc",
        "State": "stopped",
        "StartupType": "Manual"
      }
    },
    {
      "name": "DeleteUserAppContainersOnLogoff",
      "type": "Registry",
      "properties": {
        "Key": "HKEY_LOCAL_MACHINE\\SYSTEM\\CurrentControlSet\\Services\\SharedAccess\\Parameters\\FirewallPolicy",
        "Ensure": "Present",
        "ValueName": "DeleteUserAppContainersOnLogoff",
        "ValueType": "Dword",
        "ValueData": "1"
      },
      "description": "Ensures user app containers are deleted on logoff for improved security"
    },
    {
      "name": "EnableAutoLayout",
      "type": "Registry",
      "properties": {
        "Key": "HKEY_LOCAL_MACHINE\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\OptimalLayout",
        "Ensure": "Present",
        "ValueName": "EnableAutoLayout",
        "ValueType": "DWORD",
        "ValueData": "0"
      },
      "description": "Disables automatic layout adjustments for desktop icons"
    },
    {
      "name": "Enable",
      "type": "Registry",
      "properties": {
        "Key": "HKEY_LOCAL_MACHINE\\SOFTWARE\\Microsoft\\Dfrg\\BootOptimizeFunction",
        "Ensure": "Present",
        "ValueName": "Enable",
        "ValueType": "String",
        "ValueData": "N"
      },
      "description": "Disables boot optimization to reduce unnecessary disk activity"
    },
    {
      "name": "ScreenSaveActive",
      "type": "Registry",
      "properties": {
        "Key": "HKEY_USERS\\.DEFAULT\\Control Panel\\Desktop",
        "Ensure": "Present",
        "ValueName": "ScreenSaveActive",
        "ValueType": "DWORD",
        "ValueData": "0"
      },
      "description": "Disables screensaver for the default user profile"
    },
    {
      "name": "CrashDumpEnabled",
      "type": "Registry",
      "properties": {
        "Key": "HKEY_LOCAL_MACHINE\\SYSTEM\\CurrentControlSet\\Control\\CrashControl",
        "Ensure": "Present",
        "ValueName": "CrashDumpEnabled",
        "ValueType": "DWORD",
        "ValueData": "0"
      },
      "description": "Disables crash dump creation to save disk space"
    },
    {
      "name": "NtfsDisableLastAccessUpdate",
      "type": "Registry",
      "properties": {
        "Key": "HKEY_LOCAL_MACHINE\\SYSTEM\\CurrentControlSet\\Control\\FileSystem",
        "Ensure": "Present",
        "ValueName": "NtfsDisableLastAccessUpdate",
        "ValueType": "DWORD",
        "ValueData": "1"
      },
      "description": "Disables NTFS last access update to improve disk performance"
    },
    {
      "name": "ErrorMode",
      "type": "Registry",
      "properties": {
        "Key": "HKEY_LOCAL_MACHINE\\System\\CurrentControlSet\\Control\\Windows",
        "Ensure": "Present",
        "ValueName": "ErrorMode",
        "ValueType": "DWORD",
        "ValueData": "2"
      },
      "description": "Sets error mode to suppress system error dialogs"
    },
    {
      "name": "NoAutoUpdate",
      "type": "Registry",
      "properties": {
        "Key": "HKEY_LOCAL_MACHINE\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate\\AU",
        "Ensure": "Present",
        "ValueName": "NoAutoUpdate",
        "ValueType": "DWORD",
        "ValueData": "1"
      },
      "description": "Disables automatic Windows Updates for better control in Citrix environments"
    }
  ]
}